GEMINI_API_KEY="your_key_here"

# --- Local development ONLY. NEVER set this in Vercel. ---
# Enables the in-memory rate limiter, localhost CORS and ignores proxy IP headers. Without it the
# API is production-strict and returns 503 until Upstash credentials are configured.
SHRED_LOCAL_DEV=1

# --- Production abuse protection (set these in the backend Vercel project, not here) ---
# Upstash Redis REST credentials. If you add Upstash via the Vercel Marketplace it may inject these
# or KV_REST_API_URL / KV_REST_API_TOKEN instead; the API accepts either pair. Check your project's
# Environment Variables after connecting it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Gemini free-tier daily request quota (RPD) for your Google project, as shown in AI Studio. Default 20.
# GEMINI_DAILY_QUOTA=20
# Fraction of that quota the demo may spend, above 0 and at most 1. Default 0.9, because the demo
# should run in its own Google project. The shared daily budget is floor(quota * safety) Gemini
# requests across all visitors: 18 with the defaults. It resets at midnight Pacific time.
# GEMINI_QUOTA_SAFETY=0.9
# Set to 1 to also log truncated message/reply text locally. Off by default for privacy.
# LOG_USER_TEXT=1
