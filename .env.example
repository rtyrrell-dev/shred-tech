GEMINI_API_KEY="your_key_here"

# --- Local development ONLY. NEVER set this in Vercel. ---
# Allows the Vite dev server's origin (localhost) in CORS. Without it the API is production-strict
# and only the real frontend origin may call it.
SHRED_LOCAL_DEV=1

# Set to 1 to also log truncated message/reply text locally. Off by default for privacy.
# LOG_USER_TEXT=1
